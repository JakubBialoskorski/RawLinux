backup=(etc/inittab etc/fstab etc/hostname etc/hosts etc/issue etc/profile
	etc/protocols etc/passwd etc/shadow etc/group etc/gshadow etc/shells
	etc/conf.d/network)

build() {
	install -d "$PKG/etc/conf.d" "$PKG/home" "$PKG/run" "$PKG/var/log"
	install -d -m 700 "$PKG/root"
	install -m 644 inittab fstab hostname hosts issue profile protocols \
		passwd group shells "$PKG/etc/"
	install -m 600 shadow gshadow "$PKG/etc/"
	install -m 644 network "$PKG/etc/conf.d/"
	install -D -m 644 os-release "$PKG/usr/lib/os-release"
	ln -s ../usr/lib/os-release "$PKG/etc/os-release"
}
