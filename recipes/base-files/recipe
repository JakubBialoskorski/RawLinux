# base-files - configuration of the system: what init starts, the file
# systems, the network, the users and groups and the environment of
# login shells
#
# All of them are backup files, so local changes survive upgrades,
# except os-release, which names the release.
# The users and groups are the system ones of the LFS book, without the
# messagebus user, as there is no D-Bus, and with the uucp group, which
# OpenRC gives /run/lock to. Every password is locked: set the root
# password with passwd before the first boot to the login prompt.
# init starts agetty, which runs login from shadow.

name=base-files
version=1
release=3
depends=(shadow)
source=(inittab fstab hostname hosts issue profile network protocols
	passwd shadow group gshadow shells os-release)
