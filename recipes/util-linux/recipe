# util-linux - mount, agetty, fsck, hwclock and other basic system tools,
# with libblkid, libmount and libuuid
# https://github.com/util-linux/util-linux
#
# It takes over the hand-built util-linux 2.40, which came without
# headers and .pc files, so nothing could be built against its libraries.
# login, su, nologin and chfn/chsh are left out for shadow, as in the
# LFS book.
# cfdisk and the other ncurses programs use the wide libncursesw.
# pike packs every file as root:root, so make install does not chown,
# and wall and write are not setgid tty.

name=util-linux
version=2.42.2
release=2
depends=(ncurses)
makedepends=(pkgconf)
source=("https://www.kernel.org/pub/linux/utils/util-linux/v${version%.*}/util-linux-$version.tar.xz")
sha256=(03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a)

build() {
	cd "util-linux-$version"
	./configure --bindir=/usr/bin --sbindir=/usr/sbin --libdir=/usr/lib \
		--runstatedir=/run --disable-static \
		--disable-chfn-chsh --disable-login --disable-nologin --disable-su \
		--disable-setpriv --disable-runuser --disable-pylibmount \
		--disable-liblastlog2 --disable-use-tty-group \
		--disable-makeinstall-chown \
		--without-python --without-systemd --without-systemdsystemunitdir \
		--without-udev \
		ADJTIME_PATH=/var/lib/hwclock/adjtime
	make -j"$(nproc)"
	make DESTDIR="$PKG" install
}
